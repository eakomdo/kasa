          "History",
          "Abakɔsɛm"
        ],
        [
          "Elder",
          "Ɔpanyin"
        ],
        [
          "Advice",
          "Afotuo"
        ]
      ],
      "phrases": [
        [
          "It is not wrong to go back for what you forgot.",
          "Sɛ wo werɛ fi na wosan kɔ fa a, yennkyiri."
        ],
        [
          "A tree that faces the wind alone will break.",
          "Dua koro gye mframa a, ɛbu."
        ],
        [
          "Wisdom is not in one person's head.",
          "Nyansa nni onipa baako ti mu."
        ],
        [
          "A child can crack a snail's shell, not a tortoise's.",
          "Abɔfra bɔ nwa, na ɔmmɔ akyekyedeɛ."
        ]
