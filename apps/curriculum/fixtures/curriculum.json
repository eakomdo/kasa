{
  "units": [
    {
      "id": "tw-greet",
      "lang": "twi",
      "bands": [
        "lp",
        "up",
        "jhs"
      ],
      "titleLocal": "Nkyia",
      "titleEn": "Greetings and introductions",
      "strand": "Oral language",
      "contentStatus": "verified",
      "note": "Greet elders first, and use your right hand to wave or shake hands. When an older woman greets you, reply “Yaa ɛna”; for an older man, “Yaa agya”.",
      "words": [
        [
          "Good morning",
          "Maakye"
        ],
        [
          "Good afternoon",
          "Maaha"
        ],
        [
          "Good evening",
          "Maadwo"
        ],
        [
          "Welcome",
          "Akwaaba"
        ],
        [
          "Thank you",
          "Medaase"
        ],
        [
          "Please",
          "Mepa wo kyɛw"
        ],
        [
          "Sorry",
          "Kafra"
        ],
        [
          "Yes",
          "Aane"
        ],
        [
          "No",
          "Daabi"
        ],
        [
          "Goodbye (walk well)",
          "Nante yie"
        ]
      ],
      "phrases": [
        [
          "How are you?",
          "Wo ho te sɛn?"
        ],
        [
          "I am fine.",
          "Me ho yɛ."
        ],
        [
          "What is your name?",
          "Wo din de sɛn?"
        ],
        [
          "My name is Ama.",
          "Me din de Ama."
        ],
        [
          "Where do you come from?",
          "Wofiri he?"
        ],
        [
          "I come from Kumasi.",
          "Mefiri Kumasi."
        ],
        [
          "Reply to an older woman's greeting",
          "Yaa ɛna"
        ]
      ],
      "order": 0
    },
    {
      "id": "tw-family",
      "lang": "twi",
      "bands": [
        "lp",
        "up",
        "jhs"
      ],
      "titleLocal": "Abusua",
      "titleEn": "Family",
      "strand": "Vocabulary",
      "contentStatus": "verified",
      "note": "In Akan tradition, family runs through the mother's line. Your wɔfa (mother's brother) often plays a big role in your upbringing.",
      "words": [
        [
          "Family",
          "Abusua"
        ],
        [
          "Mother",
          "Maame"
        ],
        [
          "Father",
          "Agya"
        ],
        [
          "Child",
          "Abɔfra"
        ],
        [
          "Sibling",
          "Nua"
        ],
        [
          "Grandparent",
          "Nana"
        ],
        [
          "Uncle (mother's brother)",
          "Wɔfa"
        ],
        [
          "Wife",
          "Yere"
        ],
        [
          "Husband",
          "Kunu"
        ],
        [
          "Twins",
          "Ntafoɔ"
        ]
      ],
      "phrases": [
        [
          "This is my mother.",
          "Yei ne me maame."
        ],
        [
          "I have two siblings.",
          "Mewɔ anuanom baanu."
        ],
        [
          "My family is big.",
          "Me abusua yɛ kɛseɛ."
        ]
      ],
      "order": 1
    },
