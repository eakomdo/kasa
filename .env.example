# Copy to .env for local development.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# SQLite by default; for PostgreSQL: postgres://kasa:kasa@localhost:5432/kasa
DATABASE_URL=sqlite:///db.sqlite3
# Redis in production: redis://localhost:6379/0
CACHE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# GhanaNLP Khaya AI key (https://translation.ghananlp.org). Empty = offline sample translations.
KHAYA_API_KEY=
# Sample accounts (all with the public password demo1234). Defaults to DJANGO_DEBUG; never enable in production.
# KASA_DEMO_DATA=false
