# Base URL of the Kasa REST API (Django). The browser never talks to Khaya directly.
VITE_API_BASE_URL=/api
# true = use the in-browser mock backend (src/shared/api/mock). Set false once the API is live.
VITE_USE_MOCKS=true
# Artificial latency for mock responses, in ms, so loading states are visible.
VITE_MOCK_LATENCY_MS=450
